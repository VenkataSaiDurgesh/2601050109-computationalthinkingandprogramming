import time
import tracemalloc

n = 1000000

def list_processing(n):
    return [i * 2 for i in range(n)]

def generator_processing(n):
    return (i * 2 for i in range(n))

tracemalloc.start()

start = time.perf_counter()
data = list_processing(n)
list_time = time.perf_counter() - start
list_memory = tracemalloc.get_traced_memory()[1]

del data
tracemalloc.reset_peak()

start = time.perf_counter()
data = generator_processing(n)

for value in data:
    pass

generator_time = time.perf_counter() - start
generator_memory = tracemalloc.get_traced_memory()[1]

tracemalloc.stop()

print("List Processing")
print("Execution Time:", list_time, "seconds")
print("Memory Usage:", list_memory / (1024 * 1024), "MB")

print("\nGenerator Processing")
print("Execution Time:", generator_time, "seconds")
print("Memory Usage:", generator_memory / (1024 * 1024), "MB")

print("\nAnalysis:")
print("List: Higher memory usage because all values are stored.")
print("Generator: Lower memory usage because values are generated one at a time.")

