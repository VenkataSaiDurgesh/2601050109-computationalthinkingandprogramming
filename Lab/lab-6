from dataclasses import dataclass
import time

@dataclass
class StudentData:
    name: str
    roll_no: int
    marks: float

class Student:
    def __init__(self, name: str, roll_no: int, marks: float):
        self.name = name
        self.roll_no = roll_no
        self.marks = marks

start = time.perf_counter()
student1 = StudentData("Sai", 101, 85.5)
dataclass_time = time.perf_counter() - start

start = time.perf_counter()
student2 = Student("Sai", 101, 85.5)
class_time = time.perf_counter() - start

print("Dataclass Object:")
print(student1)

print("\nTraditional Class Object:")
print(student2.__dict__)

print("\nComparison:")
print("Dataclass Creation Time:", dataclass_time)
print("Traditional Class Creation Time:", class_time)
print("Dataclass provides automatic __init__, __repr__ and comparison methods.")
print("Traditional class requires these methods to be written manually.")

OUTPUT:

Dataclass Object:
StudentData(name='Sai', roll_no=101, marks=85.5)

Traditional Class Object:
{'name': 'Sai', 'roll_no': 101, 'marks': 85.5}

